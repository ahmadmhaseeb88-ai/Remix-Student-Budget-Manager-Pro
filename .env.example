# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# Authentication Secret (change this in production)
JWT_SECRET="student_budget_manager_pro_secret_key_change_in_production"

# Database Configuration (Defaults to embedded persistent JSON/SQLite storage for zero-config run)
# For Windows XAMPP / phpMyAdmin MySQL:
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=student_budget_pro
